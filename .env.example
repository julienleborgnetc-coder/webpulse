# ============================================
# Variables d'environnement WebPulse
# Copier en .env.local et remplir les valeurs
# ============================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://webpulse.vercel.app

# --- Stripe (obligatoire en production) ---
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# --- Upstash Redis (obligatoire en production) ---
# Créer un compte gratuit sur https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# --- Google Analytics ---
# Créer une propriété sur https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
